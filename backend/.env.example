NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/sanad_dev?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# From Google Cloud → Google Auth Platform → Clients (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback
# Email via Resend (resend.com). Leave empty in development: emails are printed to the terminal instead.
# Required in production, together with a verified sending domain for EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
